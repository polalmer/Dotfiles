* {
    font:"FixedsysExcelsior Nerd Font 12";
    bg:transparent;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
    border-normal: #171717;
    border-selected: #f13802; 
    text-color: #f13802;
}

window {
    location: north;
    y-offset: calc(50% - 176px);
    width: 480;
    background-color: @bg;
}

mainbox {
    padding: 12px;
}

inputbar {
    background-color: @bg;
    border-color: @border-normal;

    padding: 8px 16px;
    spacing: 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @text-color;
}

entry {
    placeholder: "Search";
    placeholder-color: #d2d2d2;
    text-color: @text-color;
}

message {
    margin: 12px 0 0;
    border-color: @border-normal;
    background-color: @bg;
}

textbox {
    padding: 8px 24px;
}

listview {
    background-color: transparent;
    margin: 12px 0 0;
    lines: 8;
    columns: 1;
    fixed-height: false;
}

element {
    padding: 8px 16px;
    spacing: 8px;
}

element normal active {
    text-color: @border-normal;
}

element alternate active {
    text-color: @border-normal;
}

element selected normal, element selected active {
    background-color: @border-selected;
}

element-icon {
    size: 1em;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
}
